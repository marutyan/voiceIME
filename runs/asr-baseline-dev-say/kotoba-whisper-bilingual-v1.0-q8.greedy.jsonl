{"id": "dev-say-0027", "system": "kotoba-whisper-bilingual-v1.0-q8.greedy", "stage": "asr", "hyp": "えっと夜で物体検出をしてからセグメントエディシングでマスクを作ります", "latency_s": 0.7181395000079647, "details": {"logmel_s": 0.0033195000141859055, "encoder_s": 0.6626179999439046, "decoder_s": 0.05217641603667289, "n_tokens": 28.0}}
