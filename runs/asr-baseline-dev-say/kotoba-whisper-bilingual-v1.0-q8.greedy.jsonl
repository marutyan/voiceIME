{"id": "dev-say-0014", "system": "kotoba-whisper-bilingual-v1.0-q8.greedy", "stage": "asr", "hyp": "えっとトランスフォーマーのアテンションの部分をもう少し軽くしたいんですけど何かいい方法ありますか?", "latency_s": 0.7285589999519289, "details": {"logmel_s": 0.0024440420093014836, "encoder_s": 0.657303958083503, "decoder_s": 0.06878679199144244, "n_tokens": 39.0}}
