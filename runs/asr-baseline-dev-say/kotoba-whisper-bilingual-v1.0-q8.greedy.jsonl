{"id": "dev-say-0022", "system": "kotoba-whisper-bilingual-v1.0-q8.greedy", "stage": "asr", "hyp": "クバネティスのポンドがメモリ不足で起きているみたいです", "latency_s": 0.7074532089754939, "details": {"logmel_s": 0.002292916993610561, "encoder_s": 0.6623781670350581, "decoder_s": 0.04275049990974367, "n_tokens": 23.0}}
