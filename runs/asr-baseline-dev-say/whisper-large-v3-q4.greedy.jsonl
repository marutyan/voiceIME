{"id": "dev-say-0016", "system": "whisper-large-v3-q4.greedy", "stage": "asr", "hyp": "あの、バッキサイズを32に、いや、16に下げたら、Vラムに収まりました。", "latency_s": 1.1119809589581564, "details": {"logmel_s": 0.0023992080241441727, "encoder_s": 0.6678781249793246, "decoder_s": 0.4416430840501562, "n_tokens": 30.0}}
