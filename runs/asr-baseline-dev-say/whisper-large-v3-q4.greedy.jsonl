{"id": "dev-say-0026", "system": "whisper-large-v3-q4.greedy", "stage": "asr", "hyp": "Dockerファイルの、いや、Docker Composeの設定を見直してください。", "latency_s": 1.0481936659198254, "details": {"logmel_s": 0.0022945828968659043, "encoder_s": 0.6573416671017185, "decoder_s": 0.38852791592944413, "n_tokens": 25.0}}
