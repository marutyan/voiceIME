+class PreparedDataset(torch.utils.data.Dataset):
+    """区間ごとに確定した条件Dの入力と正解文を、そのまま学習に渡す。"""
+
+    def __init__(self, rows, tokenizer, args):
+        """字幕で確定した教師文と保存済みの仮説・用語一覧を受け取る。"""
+        self.rows = rows
+        self.tokenizer = tokenizer
+        self.max_length = args.max_length
+
+    def __len__(self):
+        """確定した学習行数を返す。"""
+        return len(self.rows)
+
+    def __getitem__(self, index):
+        """3種類のASR結果と、取得時の固定用語一覧をトークン化する。"""
+        row = self.rows[index]
+        voice = FormatterInput(
+            first_pass=row["first_pass"], combined_text=row["combined_text"],
+            qwen_hypothesis=row["qwen_hypothesis"] or None,
+        )
+        glossary = [entry_from_record(entry) for entry in row["glossary"]]
+        return tokenize_pair(
+            self.tokenizer, voice, glossary, row["target_text"],
+            self.max_length, style_target=False,
+        )
+
 
